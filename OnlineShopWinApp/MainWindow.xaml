<Window x:Class="OnlineShopWinApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OnlineShopWinApp"
        mc:Ignorable="d"
        Title="CinemaGazyava" Height="450" Width="800">
    <Grid Background="#434b1b" Margin="10,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Menu Background="#d4c18f" Foreground="#504131">
            <MenuItem Header="🦱" FontSize="23" Click="MenuItem_Click" Cursor="Hand"/>
            <TextBox x:Name="SearchBox" Text="🔍Введите название..." Background="#d4c18f" BorderBrush="#504131" Height="25" Width="auto" MinWidth="100"
                     TextAlignment="Center" HorizontalAlignment="Center" Padding="3" Margin="5" />
        </Menu>

        <Frame Grid.Row="1" x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
