<Page x:Class="OnlineShopWinApp.Pages.OrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OnlineShopWinApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="OrderPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Vertical" Cursor="" >
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Введите ФИО:  " Height="22" Margin="10" FontSize="18"/>
                <TextBox x:Name="TextName" Height="28" Width="auto" MinWidth="100" FontSize="18" TextAlignment="Center" TextWrapping="Wrap" 
                        Background="AliceBlue" BorderBrush="#FF76A1A9" Margin="10" Cursor="IBeam"/>
                <TextBlock x:Name="NameError" Foreground="Red" FontSize="14"
           VerticalAlignment="Center" Visibility="Collapsed"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Введите Адрес:" Height="22" Margin="10" FontSize="18"/>
                <TextBox x:Name="TextAdress" Height="28" Width="Auto" MinWidth="100" FontSize="18" TextAlignment="Center" TextWrapping="Wrap" 
                         Background="AliceBlue" BorderBrush="#FF76A1A9" Margin="10" Cursor="IBeam"/>
                <TextBlock x:Name="AdressError" Foreground="Red" FontSize="14"
           VerticalAlignment="Center" Visibility="Collapsed"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Введите Почту:" Height="22" Margin="10" FontSize="18" />
                <TextBox x:Name="TextPost" Height="28" Width="Auto" MinWidth="100" FontSize="18" TextAlignment="Center" TextWrapping="Wrap" 
                        Background="AliceBlue" BorderBrush="#FF76A1A9" Margin="10" Cursor="IBeam"/>
                <TextBlock x:Name="PostError" Foreground="Red" FontSize="14"
           VerticalAlignment="Center" Visibility="Collapsed"/>
            </StackPanel>
        </StackPanel>


        <ItemsControl x:Name="OrderList" Grid.Row="1">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="140" Margin="8" Padding="8"
                            BorderBrush="CadetBlue" BorderThickness="1">
                        <StackPanel>
                            <Image Height="120" Source="{Binding Products.FullImagePath}"/>
                            <TextBlock Text="{Binding Products.Name}" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Products.Price, StringFormat={}{0} руб}"/>
                            <TextBlock Text="{Binding Quantity, StringFormat=Кол-во: {0}}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10">
            <TextBlock x:Name="TotalText" FontSize="18" VerticalAlignment="Center"/>
            <Button x:Name="OrderButton" Content="Заказать" Margin="20,0,0,0" Padding="16,4" Click="OrderButton_Click" Cursor="Hand"
                                     Background="AliceBlue" BorderBrush="#FF76A1A9" Foreground="#FF004461"/>
        </StackPanel>
    </Grid>
</Page>
