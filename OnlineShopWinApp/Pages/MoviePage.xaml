<Page x:Class="OnlineShopWinApp.Pages.MoviePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OnlineShopWinApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MoviePage">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0" x:Name="BackBtn" Click="BackBtn_Click" HorizontalAlignment="Left" Content="Назад" Width="80" Margin="0,0,0,10"
                 Background="#d4c18f" BorderBrush="#504131" Foreground="#504131" Cursor="Hand"/>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Image x:Name="PosterImage" Width="200" Height="300" Margin="0,0,15,0" Stretch="UniformToFill"/>

            <StackPanel Grid.Column="1">
                <TextBlock x:Name="TitleText" FontSize="26" FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBlock x:Name="RatingText" FontSize="18" Margin="0,8,0,0"/>
                <TextBlock x:Name="AgeText" Margin="0,4,0,0"/>
                <TextBlock x:Name="GenreText" Margin="0,4,0,0"/>
                <TextBlock x:Name="DiscriptionText" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,15,0,0">
            <TextBlock Text="Сеансы" FontSize="24" FontWeight="Bold" Margin="0,0,0,5" Foreground="#d4c18f" Cursor=""/>
            <ListView x:Name="SessionsList" MaxHeight="300">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="2">
                            <TextBlock Text="{Binding Time, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" Width="140" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding HallNumber, StringFormat=Зал: {0}}" Width="70" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding HallRating, StringFormat='Рейтинг зала: {0}'}" Width="140" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Price, StringFormat='{}{0:F0} рублей'}" Width="70" VerticalAlignment="Center" />
                            <Button x:Name="SelectSessionBtn" Click="SelectSessionBtn_Click" Content="Выбрать Место" Tag="{Binding Id}" Padding="8,2"
                                    Background="#d4c18f" BorderBrush="#504131" Foreground="#504131" Cursor="Hand"/>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            
        </StackPanel>
    </Grid>
</Page>
