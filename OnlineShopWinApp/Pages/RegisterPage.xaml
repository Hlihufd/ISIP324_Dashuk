<Page x:Class="OnlineShopWinApp.Pages.RegisterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OnlineShopWinApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="RegisterPage">

    <StackPanel Width="250" VerticalAlignment="Center">
        <TextBlock Text="Регистрация" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>

        <TextBlock Text="ФИО"/>
        <TextBox x:Name="FullNameBox" Margin="0,2,0,10"/>

        <TextBlock Text="Email"/>
        <TextBox x:Name="EmailBox" Margin="0,2,0,10"/>

        <TextBlock Text="Логин"/>
        <TextBox x:Name="LoginBox" Margin="0,2,0,10"/>

        <TextBlock Text="Пароль"/>
        <PasswordBox x:Name="PassBox" Margin="0,2,0,15"/>
        
        <Button x:Name="RegisterBtn" Content="Зарегистрироваться" Click="RegisterBtn_Click" Height="30"/>
        <Button x:Name="BackBtn" Content="Назад" Click="BackBtn_Click" Height="30" Margin="0,8,0,0"/>
    </StackPanel>
</Page>
