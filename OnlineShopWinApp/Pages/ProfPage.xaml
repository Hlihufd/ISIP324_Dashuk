<Page x:Class="OnlineShopWinApp.Pages.ProfPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OnlineShopWinApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProfPage">

    <Grid>
        <StackPanel Margin="15">
            <TextBlock Text="Личный кабинет" FontSize="28" FontWeight="Bold" Foreground="#d4c18f"/>
            
            <TextBlock x:Name="FullNameText" FontSize="16" Margin="0,10,0,0"/>
            <TextBlock x:Name="LoginText" />
            <TextBlock x:Name="EmailText"/>

            <TextBlock Text="Мои Билеты" FontSize="24" Margin="0,20,0,5" Foreground="#d4c18f"/>

            <ListView x:Name="TicketsList" Height="300" 
                      Background="#434b1b" BorderBrush="#d4c18f" BorderThickness="1">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#504131" BorderThickness="1.5" Padding="8" Margin="2">
                            <StackPanel>
                                <TextBlock Text="{Binding Movie}" FontWeight="Bold" FontSize="15"/>
                                <TextBlock Text="{Binding Time, StringFormat='Сеанс {0:dd.MM.yyyy HH:mm}'}"/>
                                <TextBlock Text="{Binding Hall, StringFormat='Зал: {0}'}"/>
                                <TextBlock>
                                    <Run Text="Ряд "/><Run Text="{Binding RowNumber, Mode=OneWay}"/>
                                    <Run Text=", место "/><Run Text="{Binding SeatNumber, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding Price, StringFormat='Цена: {0:0F} рублей'}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Grid>
</Page>
