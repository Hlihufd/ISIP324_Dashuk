<Page x:Class="OnlineShopWinApp.Pages.TicketPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OnlineShopWinApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="TicketPage">

    <Border Width="340" VerticalAlignment="Center" Padding="20"
            Background="#d4c18f" BorderBrush="#504131" BorderThickness="1" CornerRadius="8">
        <StackPanel>
            <TextBlock Text="Оформление билета" FontSize="22" FontWeight="Bold"
                       Foreground="#504131" HorizontalAlignment="Center" Margin="0,0,0,15"/>

            <TextBlock x:Name="MovieText" FontSize="16" FontWeight="Bold" Foreground="#504131" TextWrapping="Wrap"/>
            <TextBlock x:Name="HallText" Foreground="#504131" Margin="0,6,0,0"/>
            <TextBlock x:Name="TimeText" Foreground="#504131" Margin="0,2,0,0"/>
            <TextBlock x:Name="SeatText" Foreground="#504131" Margin="0,2,0,0"/>
            <TextBlock x:Name="PriceText" FontSize="18" FontWeight="Bold" Foreground="#504131" Margin="0,10,0,15"/>

            <Button Content="Подтвердить" Height="32" Click="ConfirmBtn_Click"/>
            <Button Content="Отмена" Height="32" Margin="0,8,0,0" Click="CancelBtn_Click"/>
        </StackPanel>
    </Border>
</Page>
