<Page x:Class="OnlineShopWinApp.Pages.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:OnlineShopWinApp.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl x:Name="MoviesList" Margin="10">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="170" Margin="8" Padding="6" Background="#d4c18f" BorderBrush="#504131" BorderThickness="1" CornerRadius="6"
                            Cursor="Hand" MouseLeftButtonUp="Card_Click">
                        <StackPanel>
                            <Image Source="{Binding PosterPath}" Width="150" Height="225" Stretch="UniformToFill"/>
                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#504131"/>
                            <TextBlock Text="{Binding Rating, StringFormat=Рейтинг: {0}}" Foreground="#504131"/>
                            <TextBlock Text="{Binding StartDate, StringFormat=Начало: {0:dd.MM.yyyy}}" Foreground="#504131"/>
                            <TextBlock Text="{Binding AgeRating, StringFormat=Возраст: {0}}" Foreground="#504131"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</Page>
