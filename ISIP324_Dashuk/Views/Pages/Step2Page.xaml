<UserControl x:Class="CarConfigurator.Views.Pages.Step2Page"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<StackPanel>
		<TextBlock Style="{StaticResource SubHeader}" Text="Шаг 2. Цвет и опции"/>

		<TextBlock Text="Цвет кузова"/>
		<ComboBox ItemsSource="{Binding Colors}" SelectedItem="{Binding SelectedColor}"/>

		<TextBlock Text="Дополнительные опции"/>
		<ItemsControl ItemsSource="{Binding Options}">
			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<CheckBox Content="{Binding}" IsChecked="{Binding IsSelected}" Click="CheckBox_Click"/>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>

		<TextBlock Style="{StaticResource SubHeader}" Text="Стоимость"/>
		<TextBlock Text="{Binding SelectedColor.Extra, Converter={StaticResource Currency}, ConverterParameter='Цвет: '}"/>
		<TextBlock Text="{Binding OptionsPrice, Converter={StaticResource Currency}, ConverterParameter='Опции: '}"/>
		<TextBlock FontWeight="Bold" Text="{Binding Total, Converter={StaticResource Currency}, ConverterParameter='Итого: '}"/>
	</StackPanel>
</UserControl>