<UserControl x:Class="CarConfigurator.Views.Pages.Step5Page"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<StackPanel>
		<TextBlock Style="{StaticResource SubHeader}" Text="Шаг 5. Оформление заявки"/>

		<TextBlock Text="Имя"/>
		<TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

		<TextBlock Text="Телефон (только цифры)"/>
		<TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>

		<TextBlock Text="E-mail"/>
		<TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

		<TextBlock Foreground="Gray" Text="Заполните все поля корректно, чтобы отправить заявку"
                   Visibility="{Binding HasErrors, Converter={StaticResource BoolToVis}}"/>

		<TextBlock Style="{StaticResource SubHeader}" Text="Ваша конфигурация"/>
		<TextBlock Text="{Binding Summary}" LineHeight="24" TextWrapping="Wrap"/>
	</StackPanel>
</UserControl>