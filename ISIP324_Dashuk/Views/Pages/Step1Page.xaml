<UserControl x:Class="CarConfigurator.Views.Pages.Step1Page"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<StackPanel>
		<TextBlock Style="{StaticResource SubHeader}" Text="Шаг 1. Модель и двигатель"/>

		<TextBlock Text="Модель"/>
		<ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}"/>

		<TextBlock Text="Двигатель"/>
		<ComboBox ItemsSource="{Binding Engines}" SelectedItem="{Binding SelectedEngine}"/>

		<TextBlock Style="{StaticResource SubHeader}" Text="Стоимость"/>
		<TextBlock Text="{Binding SelectedModel.BasePrice, Converter={StaticResource Currency}, ConverterParameter='База: '}"/>
		<TextBlock Text="{Binding SelectedEngine.Extra, Converter={StaticResource Currency}, ConverterParameter='Двигатель: '}"/>
		<TextBlock FontWeight="Bold" Text="{Binding Total, Converter={StaticResource Currency}, ConverterParameter='Итого: '}"/>
	</StackPanel>
</UserControl>