<UserControl x:Class="ISIP324_Dashuk.Views.Pages.Step4Page"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<StackPanel>
		<TextBlock Style="{StaticResource SubHeader}" Text="Шаг 4. Автокредит"/>
		<TextBlock Text="{Binding Total, Converter={StaticResource Currency}, ConverterParameter='Стоимость автомобиля: '}"/>

		<TextBlock Margin="0,20,0,0" Text="{Binding Percent, StringFormat='Первоначальный взнос: {0}%'}"/>
		<Slider Minimum="10" Maximum="90" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding Percent}"/>

		<TextBlock Margin="0,10,0,0" Text="{Binding Months, StringFormat='Срок кредита: {0} мес.'}"/>
		<Slider Minimum="12" Maximum="96" TickFrequency="6" IsSnapToTickEnabled="True" Value="{Binding Months}"/>

		<TextBlock Style="{StaticResource SubHeader}" Text="Расчёт"/>
		<TextBlock Text="{Binding DownPayment, Converter={StaticResource Currency}, ConverterParameter='Первоначальный взнос: '}"/>
		<TextBlock Text="{Binding Loan, Converter={StaticResource Currency}, ConverterParameter='Сумма кредита: '}"/>
		<TextBlock FontSize="22" FontWeight="Bold" Margin="0,10,0,0"
                   Text="{Binding Monthly, Converter={StaticResource Currency}, ConverterParameter='Платёж в месяц: '}"/>
	</StackPanel>
</UserControl>