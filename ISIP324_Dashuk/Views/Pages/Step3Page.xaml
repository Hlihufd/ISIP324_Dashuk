<UserControl x:Class="ISIP324_Dashuk.Views.Pages.Step3Page"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<StackPanel>
		<TextBlock Style="{StaticResource SubHeader}" Text="Шаг 3. Итоговая стоимость"/>
		<TextBlock Text="{Binding Summary}" LineHeight="26" TextWrapping="Wrap"/>

		<TextBlock Style="{StaticResource SubHeader}" Text="Из чего складывается цена"/>
		<TextBlock Text="{Binding Config.Model.BasePrice, Converter={StaticResource Currency}, ConverterParameter='База: '}"/>
		<TextBlock Text="{Binding Config.Engine.Extra, Converter={StaticResource Currency}, ConverterParameter='Двигатель: '}"/>
		<TextBlock Text="{Binding Config.Color.Extra, Converter={StaticResource Currency}, ConverterParameter='Цвет: '}"/>
		<TextBlock Text="{Binding OptionsPrice, Converter={StaticResource Currency}, ConverterParameter='Опции: '}"/>
		<TextBlock FontSize="22" FontWeight="Bold" Margin="0,10,0,0"
                   Text="{Binding Total, Converter={StaticResource Currency}, ConverterParameter='Итого: '}"/>
	</StackPanel>
</UserControl>